# macOS
.DS_Store

# Reference projects (read-only, never committed)
references/

# Swift and Xcode builds
.build/
.build-*/
.swiftpm/
DerivedData/
*.xcodeproj/xcuserdata/
dist/

# Python environments and caches (the uv environment is .venv; uv.lock is tracked)
.venv/
.venv-*/
__pycache__/
*.pyc
.mypy_cache/
.ruff_cache/

# Data: downloads and everything generated from them (lexicon, corpora, language models, Core ML and ONNX models,
# checkpoints, evaluation outputs), in data/raw/ and data/build/; data/ may also be a symlink to a shared copy.
# Each ml/src/zhuyintype_ml/training/ directory documents how to rebuild its outputs.
/data

# Training, inference and evaluation outputs written next to the code
ml/**/results/
ml/**/work/
ml/**/logs/
ml/**/outputs/
ml/**/checkpoints/
*.log

# Model files, wherever they end up
*.pt
*.pth
*.ckpt
*.safetensors
*.onnx
*.onnx.data
*.mlmodel
*.mlpackage/
*.mlmodelc/
*.bin
!Resources/**/*.bin

# Agent run logs
.codex-logs/

# Downloaded build tools (Sparkle CLI)
.tools/

# Local remote-host settings (see .remote.env.example)
.remote.env

# Downloaded asset archives
.cache/
# engine/parity/gate.sh results
/gate-out/
