#!/usr/bin/env bash
# Before every push, everything CI would reject for what the push adds: formatting, lint, clippy, types and the
# Python tests (tools/check-changes.sh --push).  A new branch is compared with origin/main.  Skip deliberately with
# `git push --no-verify`.
set -euo pipefail
root=$(git rev-parse --show-toplevel)
zero=0000000000000000000000000000000000000000
status=0
while read -r _local_ref local_sha _remote_ref remote_sha; do
  [[ $local_sha == "$zero" ]] && continue                      # deleting a branch or tag
  [[ $(git cat-file -t "$local_sha") == commit ]] || continue  # an annotated tag points at a tag object
  if [[ $remote_sha == "$zero" ]] || ! git cat-file -e "$remote_sha" 2>/dev/null; then
    base=$(git merge-base origin/main "$local_sha" 2>/dev/null || true)
    [[ -n $base ]] || continue
  else
    base=$remote_sha
  fi
  [[ $base == "$local_sha" ]] && continue
  "$root/tools/check-changes.sh" --push "$base" "$local_sha" || status=1
done
exit $status
