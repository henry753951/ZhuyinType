#!/bin/sh
# zt: ZhuyinType's tools (`tools/zt help`).  Runs `python -m zhuyintype_ml.cli` in the uv project ml/, from
# any working directory, passing every argument through.  Needs uv (https://docs.astral.sh/uv/); uv provides Python.
#
#   tools/zt help
#   tools/zt setup
#   tools/zt --remote eval conversion --config engine -n 3 --set smoke
set -eu

# The repository: two levels up from this file, following symlinks (so ~/bin/zt -> .../tools/zt works).
self=$0
while [ -L "$self" ]; do
    target=$(readlink "$self")
    case $target in /*) self=$target ;; *) self=$(dirname "$self")/$target ;; esac
done
root=$(cd "$(dirname "$self")/.." && pwd -P)

# uv: $ZT_UV, PATH, then the installer's default locations.
uv=${ZT_UV:-$(command -v uv 2>/dev/null || true)}
for candidate in "$HOME/.local/bin/uv" "$HOME/.cargo/bin/uv"; do
    [ -n "$uv" ] && break
    [ -x "$candidate" ] && uv=$candidate
done
if [ -z "$uv" ]; then
    echo 'zt: uv not found. Install it with `curl -LsSf https://astral.sh/uv/install.sh | sh` (or `brew install uv`), then run `tools/zt setup`.' >&2
    exit 127
fi

PYTHONPATH="$root/ml/src${PYTHONPATH:+:$PYTHONPATH}"
ZT_UV=$uv
export PYTHONPATH ZT_UV
exec "$uv" run --quiet --project "$root/ml" python -m zhuyintype_ml.cli "$@"
