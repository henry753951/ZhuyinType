                  "--v3", "{data}/v3", "--v3-weight", "1"]}
  ],
  "sets": [
    {"name": "colloquial", "set": "colloquial-dev"},
    {"name": "wikipedia", "set": "wiki-dev"},
    {"name": "chat", "set": "chat-dev"},
    {"name": "context", "set": "wiki-dev", "options": ["--context", "line"]},
    {"name": "continue", "set": "colloquial-dev", "options": ["--split", "continue"]}
  ]
}
