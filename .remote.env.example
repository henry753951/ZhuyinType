# Copy to .remote.env (never committed) and fill in: the GPU host that runs training and evaluation.
# `tools/zt --remote <command>` and `tools/zt remote ...` read these; the environment overrides this file.
ZHUYIN_REMOTE_HOST=user@gpu-host
# Optional: the SSH key (otherwise ~/.ssh/config decides).
ZHUYIN_REMOTE_KEY=$HOME/.ssh/id_ed25519
# Optional: ZhuyinType's directory on the host, relative to its home (work/, logs/, asset-cache/ go under it).
# ZHUYIN_REMOTE_BASE=zhuyintype
