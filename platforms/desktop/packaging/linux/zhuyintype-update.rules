// Lets the user at the computer (an active, local session) start ZhuyinType's updater without a password.  The
// updater installs only a release signed with the project's key (zt_core::update); nothing else about the unit can
// be changed this way.
polkit.addRule(function (action, subject) {
    if (action.id == "org.freedesktop.systemd1.manage-units" &&
        action.lookup("unit") == "zhuyintype-update.service" &&
        action.lookup("verb") == "start" &&
        subject.active && subject.local) {
        return polkit.Result.YES;
    }
});
