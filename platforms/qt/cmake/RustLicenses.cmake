# Writes the licence texts of every Rust crate the engine library links (normal and build dependencies, all targets),
# the Linux/Windows counterpart of platforms/macos/scripts/rust-licenses.swift. Fails when a crate has no licence file.
# Run: cmake -DENGINE_DIR=<engine> -DOUTPUT=<Rust-crates.txt> -P RustLicenses.cmake
find_program(CARGO cargo HINTS "$ENV{CARGO_HOME}/bin" "$ENV{HOME}/.cargo/bin" "$ENV{USERPROFILE}/.cargo/bin" REQUIRED)
execute_process(COMMAND "${CARGO}" tree --locked -p zhuyin-ffi -e normal,build --prefix none --format "{p}|{l}" --target all
    WORKING_DIRECTORY "${ENGINE_DIR}" OUTPUT_VARIABLE tree RESULT_VARIABLE status)
if(NOT status EQUAL 0)
    message(FATAL_ERROR "cargo tree failed (${status})")
endif()
set(cargo_home "$ENV{CARGO_HOME}")
if(NOT cargo_home)
    if(DEFINED ENV{USERPROFILE} AND NOT DEFINED ENV{HOME})
        set(cargo_home "$ENV{USERPROFILE}/.cargo")
    else()
        set(cargo_home "$ENV{HOME}/.cargo")
    endif()
endif()
string(REPLACE "\r" "" tree "${tree}")
string(REPLACE "\n" ";" lines "${tree}")
list(REMOVE_DUPLICATES lines)
list(SORT lines)
set(output "Rust 套件授權（Linux／Windows，包含各平台與建置相依套件）\n")
set(missing "")
set(seen "")
foreach(line IN LISTS lines)
    string(REGEX REPLACE " \\(\\*\\)$" "" line "${line}")
    # Workspace crates print their path in parentheses; they are this program (AGPL-3.0-only).
    if(line STREQUAL "" OR line MATCHES "\\(/" OR line MATCHES "\\([A-Za-z]:")
        continue()
    endif()
    if(NOT line MATCHES "^([^ ]+) v([^ |]+)\\|(.*)$")
        continue()
    endif()
    set(name "${CMAKE_MATCH_1}")
    set(version "${CMAKE_MATCH_2}")
    set(license "${CMAKE_MATCH_3}")
    if("${name}-${version}" IN_LIST seen)
        continue()
    endif()
    list(APPEND seen "${name}-${version}")
    file(GLOB directories LIST_DIRECTORIES true "${cargo_home}/registry/src/*/${name}-${version}")
    if(NOT directories)
        list(APPEND missing "${name} ${version}")
        continue()
    endif()
    list(GET directories 0 directory)
    file(GLOB files LIST_DIRECTORIES false RELATIVE "${directory}" "${directory}/*")
    set(licenses "")
    foreach(file IN LISTS files)
        string(TOUPPER "${file}" upper)
        if(upper MATCHES "^(LICEN[CS]E|COPYING|NOTICE|UNLICENSE)")
            list(APPEND licenses "${file}")
        endif()
    endforeach()
    list(SORT licenses)
    set(has_license FALSE)
    foreach(file IN LISTS licenses)
        string(TOUPPER "${file}" upper)
        if(upper MATCHES "^(LICEN[CS]E|COPYING|UNLICENSE)")
            set(has_license TRUE)
        endif()
    endforeach()
    if(NOT has_license)
        list(APPEND missing "${name} ${version}")
        continue()
    endif()
    if(license STREQUAL "")
        set(license "未標示")
    endif()
    string(APPEND output "\n===== ${name} ${version} — ${license} =====\n")
    foreach(file IN LISTS licenses)
        file(READ "${directory}/${file}" text)
        string(APPEND output "\n--- ${file} ---\n${text}\n")
    endforeach()
endforeach()
if(missing)
    message(FATAL_ERROR "No licence file for: ${missing}")
endif()
file(WRITE "${OUTPUT}.tmp" "${output}")
file(RENAME "${OUTPUT}.tmp" "${OUTPUT}")
