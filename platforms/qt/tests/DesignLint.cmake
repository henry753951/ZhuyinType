# Checks the design rules in DESIGN_SYSTEM.md that a machine can check, so a page built later cannot drift from the
# shared look. Run: cmake -DQML_DIR=<platforms/qt/qml> -DCMAKE_LISTS=<platforms/qt/CMakeLists.txt> -P DesignLint.cmake
#
# Pages compose components; they never style a Qt control themselves. Components (every other QML file) may use Qt
# controls, but still take every colour from Theme.qml. A new page must be added to this list.
set(pages Main OverviewPages AboutPages InputPages LibraryPages ShortcutOverview AppearancePage SettingsPage LiveInput WizardWindow)

set(problems "")
file(READ "${CMAKE_LISTS}" cmake_lists)
file(GLOB qml_files LIST_DIRECTORIES false "${QML_DIR}/*.qml" "${QML_DIR}/*.js")
foreach(path IN LISTS qml_files)
    get_filename_component(file "${path}" NAME)
    get_filename_component(name "${path}" NAME_WE)
    if(NOT cmake_lists MATCHES "qml/${file}")
        string(APPEND problems "${file}: not listed in QML_FILES of CMakeLists.txt\n")
    endif()
    if(file MATCHES "\\.js$" OR name STREQUAL "Theme")
        continue()
    endif()
    file(STRINGS "${path}" lines ENCODING UTF-8)
    list(FIND pages "${name}" index)
    set(page FALSE)
    if(NOT index EQUAL -1)
        set(page TRUE)
    endif()
    set(number 0)
    foreach(line IN LISTS lines)
        math(EXPR number "${number} + 1")
        if(line MATCHES "^[ \t]*//")
            continue()
        endif()
        # Every colour comes from Theme.qml.
        if(line MATCHES "\"#[0-9a-fA-F][0-9a-fA-F][0-9a-fA-F]")
            string(APPEND problems "${file}:${number}: hard-coded colour; use a Theme token\n")
        endif()
        if(page)
            if(line MATCHES "^[ \t]*([A-Za-z.]+:[ \t]*)?(Button|ToolButton|RoundButton|TextField|TextArea|ComboBox|CheckBox|RadioButton|Switch|SpinBox|Slider|Dialog|Menu|MenuItem|DialogButtonBox|Popup|CheckDelegate|ItemDelegate)[ \t]*\\{")
                string(APPEND problems "${file}:${number}: a page styles a raw Qt control; use the App* component\n")
            endif()
            if(line MATCHES "pixelSize:[ \t]*[0-9]")
                string(APPEND problems "${file}:${number}: font size as a number; use theme.bodySize, detailSize, ...\n")
            endif()
            if(line MATCHES "palette\\.")
                string(APPEND problems "${file}:${number}: palette colours on a control; use a component instead\n")
            endif()
        endif()
        # Icons are drawn with Icon, never with text characters.
        if(line MATCHES "text:.*(ⓘ|›|‹|×|✕|✓|⌃\\\\n⌄)")
            string(APPEND problems "${file}:${number}: a character used as an icon; use Icon { name: ... }\n")
        endif()
    endforeach()
endforeach()

if(problems)
    message(FATAL_ERROR "Design rules broken (see platforms/qt/DESIGN_SYSTEM.md):\n${problems}")
endif()
message(STATUS "Design rules hold for every QML file.")
